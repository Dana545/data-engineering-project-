# scatter plot for the relationship between a country's area and the number of countries bordering it
border_count = []
for borders in df['borders']:#We convert the borders lists into numerical values representing the number of bordering countries so we can analyze them using a scatter plot
    if borders is None:
        border_count.append(0)
    else:
        border_count.append(len(borders)) 
df['border_count'] = border_count
sns.scatterplot( y=df['border_count'], x=df['area'])
plt.title("country area vs. num of bordering countries")
plt.xlabel("Area * 10^7")
plt.ylabel("Number of bordering countries")
plt.show()
print("This scatter plot helps us investigate whether larger countries tend to have more bordering countries.Based on the results,the largest areas have very few borders")
